ARG NODESOURCE_SIGNER_FPR=6F71F525282841EEDAF851B42F59B5F99B1BE0B4
FROM ubuntu:26.04@sha256:f144425ff09be612d6d9ad965196e9cdc23dae1f42110a8a11a3e9a8198759f7 AS build
LABEL org.opencontainers.image.title="MineOS" \
      org.opencontainers.image.description="Minecraft server manager and web user interface" \
      org.opencontainers.image.authors="William Dizon (original author); Kris Kersey (Kersey Fabrications)" \
      org.opencontainers.image.source="https://github.com/KerseyFabrications/mineos-node" \
      org.opencontainers.image.licenses="GPL-3.0-only"

#set build directory
WORKDIR /build

#install necessary build dependancies
ARG DEBIAN_FRONTEND=noninteractive
ARG NODESOURCE_SIGNER_FPR
RUN apt-get update && apt-get install -y \
  curl \
  build-essential \
  && apt-get install -y gnupg \
  && curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key -o /tmp/nodesource.key \
  && export GNUPGHOME="$(mktemp -d)" \
  && gpg --batch --quiet --import /tmp/nodesource.key \
  && gpg --batch --export "${NODESOURCE_SIGNER_FPR}" > /usr/share/keyrings/nodesource.gpg \
  && test -s /usr/share/keyrings/nodesource.gpg \
  && rm -rf "$GNUPGHOME" \
  && echo "deb [signed-by=/usr/share/keyrings/nodesource.gpg] https://deb.nodesource.com/node_24.x nodistro main" \
     > /etc/apt/sources.list.d/nodesource.list \
  && apt-get update && apt-get install -y nodejs

# copy package.json and the lockfile and install from it
# by copying them first we stop changes in other files from triggering a rebuild of this image stage
COPY package.json package-lock.json /build/
RUN npm ci --omit=dev --no-audit --no-fund

#copy other files to build dir
COPY . /build

#final image
FROM ubuntu:26.04@sha256:f144425ff09be612d6d9ad965196e9cdc23dae1f42110a8a11a3e9a8198759f7

WORKDIR /usr/games/minecraft

#install necessary run dependancies
ARG DEBIAN_FRONTEND=noninteractive
ARG NODESOURCE_SIGNER_FPR
RUN apt-get update && apt-get install -y \
  rdiff-backup \
  screen \
  rsync \
  git \
  curl \
  rlwrap \
  unzip \
  openjdk-25-jre-headless \
  openjdk-21-jre-headless \
  openjdk-8-jre-headless \
  ca-certificates-java \
  && update-alternatives --set java /usr/lib/jvm/java-25-openjdk-$(dpkg --print-architecture)/bin/java \
  && apt-get install -y gnupg \
  && curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key -o /tmp/nodesource.key \
  && export GNUPGHOME="$(mktemp -d)" \
  && gpg --batch --quiet --import /tmp/nodesource.key \
  && gpg --batch --export "${NODESOURCE_SIGNER_FPR}" > /usr/share/keyrings/nodesource.gpg \
  && test -s /usr/share/keyrings/nodesource.gpg \
  && rm -rf "$GNUPGHOME" \
  && echo "deb [signed-by=/usr/share/keyrings/nodesource.gpg] https://deb.nodesource.com/node_24.x nodistro main" \
     > /etc/apt/sources.list.d/nodesource.list \
  && apt-get update && apt-get install -y nodejs \
  && apt-get remove --purge -y gnupg \
  && apt-get autoremove -y \
  && apt-get clean \
  && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

COPY --from=build /build /usr/games/minecraft
RUN cp /usr/games/minecraft/mineos.conf /etc/mineos.conf \
  && cp /usr/games/minecraft/entrypoint.sh /entrypoint.sh

#set start command and entrypoint
CMD ["node", "webui.js"]
ENTRYPOINT ["/entrypoint.sh"]

#set image ports volumes and envs
EXPOSE 8443 25565-25570
VOLUME /var/games/minecraft
VOLUME /etc/ssl/certs
ENV USER_NAME=mc USER_UID=1000 USE_HTTPS=true SERVER_PORT=8443 \
    MINEOS_SHUTDOWN_TIMEOUT=120
